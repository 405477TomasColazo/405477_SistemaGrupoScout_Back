##### Application Properties Template #####
# Copy this file to application.properties and configure the environment variables
# or replace the placeholders with actual values for local development

app.name='@project.name@'
app.desc='@project.description@'
app.version='@project.version@'
app.url=${APP_URL:http://localhost:8080}
server.port=${PORT:8080}
app.dev-name=Your Name
app.dev-email=your.email@example.com
app.frontend.url=${FRONTEND_URL:http://localhost:4200}

# Configuración de Swagger UI
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

## Spring Data Source ##
# Configure your database connection
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/your_database_name}
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_db_password}

## Spring JPA ##
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}

## MAIL ##
# Configure your email service (Gmail SMTP example)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:your.email@gmail.com}
spring.mail.password=${MAIL_PASSWORD:your_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

## JWT ##
# Use a strong, unique secret key for JWT tokens
SECRET_KEY=${JWT_SECRET_KEY:your-very-secure-jwt-secret-key-here}

## MercadoPago ##
# Configure your MercadoPago credentials
token.mp=${MP_TOKEN:your_mercadopago_token}

## Webhook Configuration ##
# Configure webhook security
webhook.mercadopago.secret=${WEBHOOK_MP_SECRET:your-webhook-secret}
webhook.mercadopago.validate-signature=${WEBHOOK_MP_VALIDATE:true}
webhook.mercadopago.allowed-actions=payment.created,payment.updated

## Logging ##
logging.level.org.springframework.security=${LOG_LEVEL_SECURITY:WARN}
logging.level.root=${LOG_LEVEL_ROOT:INFO}

## IMPORTANT SECURITY NOTES ##
# 1. NEVER commit this file with real credentials to version control
# 2. Use environment variables in production
# 3. Keep JWT_SECRET_KEY complex and unique
# 4. Use strong database passwords
# 5. For Gmail, use App Passwords, not your regular password
# 6. Validate all webhook signatures in production